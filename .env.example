# local 이면 이 브라우저에만 저장합니다.
# firebase 이면 Firestore에 저장합니다.
STORAGE_MODE=firebase

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# 주의: 여기에 인증용 "비밀키"를 넣고 firestore.rules에서 검증하는 방식은
# 정적 프론트에서는 안전하지 않습니다. (브라우저에 노출됨)
